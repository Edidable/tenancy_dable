# frozen_string_literal: true

# TenancyDable configuration. Every setting below shows its DEFAULT; uncomment a
# line to override it. As shipped, the defaults give you: fail-OPEN scoping (flip
# `require_tenant` to fail closed), owner/admin/member roles, slug-based tenant
# resolution on "/:tenant_slug", and audit logging of mid-request tenant changes.
#
# Full guide: https://github.com/edidable/tenancy_dable
TenancyDable.configure do |config|
  # --- Model names ---------------------------------------------------------
  # config.tenant_model     = "Tenant"       # the workspace model
  # config.user_model       = "User"         # the global identity model
  # config.membership_model = "Membership"   # the user <-> tenant join model

  # --- Roles ---------------------------------------------------------------
  # Ordered highest-first. One predicate per role is generated on the membership
  # (owner?, admin?, member?, ...); `roles.first` is the owner role.
  # config.roles         = %w[owner admin member]
  # config.manager_roles = %w[owner admin]   # the "can manage the workspace" set

  # --- Columns & params ----------------------------------------------------
  # config.tenant_fk  = :tenant_id    # foreign key on tenant-scoped models
  # config.slug_param = :tenant_slug  # URL param tenant resolution reads

  # --- Scoping behaviour ----------------------------------------------------
  # When truthy-in-context, an unscoped query on a scoped model raises
  # TenancyDable::NoTenantError instead of leaking every tenant's rows (fail
  # closed). Accepts a boolean OR a callable evaluated per query.
  # config.require_tenant = false

  # Reads. While a tenant is current, a read of a scoped model pinned to another
  # tenant, or whose tenant filter was removed (`a.widgets` while acting in B,
  # `unscope(where: :tenant_id)`), raises TenancyDable::CrossTenantReadError
  # instead of returning that tenant's rows. Set false to restore the pre-0.5
  # behaviour; enter the other tenant with `with_tenant` or wrap a deliberate
  # cross-tenant read in `without_tenant`.
  # config.guard_reads = true

  # --- Postgres row-level security (optional) ------------------------------
  # config.rls = false
  # config.rls_statement = ->(tenant) { "SET app.tenant_id = #{ActiveRecord::Base.connection.quote(tenant&.id)}" }

  # --- Auditing -------------------------------------------------------------
  # Behaviour when current_tenant is reassigned to a DIFFERENT tenant mid-request:
  #   :log    (default) log tenant ids only, never payloads (security invariant 6)
  #   :raise  raise TenancyDable::TenantOverrideError
  #   :ignore say nothing
  # config.audit_overrides = :log

  # What happens when tenant state is written under a fiber scheduler while
  # Active Support isolates `Current` per thread (every fiber would share one
  # tenant):
  #   :raise  (default) raise TenancyDable::UnsafeIsolationError — fix it with
  #           `config.active_support.isolation_level = :fiber`
  #   :warn   log it on every write and carry on
  #   :off    say nothing
  # config.isolation_check = :raise

  # When true, `without_tenant` needs a non-blank `reason:` and raises
  # TenancyDable::BypassReasonError without one. Every bypass is reported on the
  # "without_tenant.tenancy_dable" notification either way.
  # config.require_bypass_reason = false

  # `rake tenancy_dable:audit` (and TenancyDable.audit) reports models that
  # declare no tenancy: use belongs_to_tenant, or tenant_global because: "...".
  # Namespaces it skips, and reviewed models you do not own (name => reason):
  # config.audit_ignored_namespaces = %w[ActiveStorage ActionText ActionMailbox SolidQueue SolidCache SolidCable]
  # config.audit_allowed = {}

  # --- Resolution -----------------------------------------------------------
  # When a slug matches no tenant: :raise (ActiveRecord::RecordNotFound) or
  # :null (proceed with no tenant in context).
  # config.on_tenant_not_found = :raise

  # When the acting user is NOT a member of the resolved tenant:
  #   :not_a_member_error  (default) raise TenancyDable::NotAMemberError
  #   :not_authorized      raise Pundit::NotAuthorizedError (loaded lazily) — handy
  #                        when your controllers already
  #                        `rescue_from Pundit::NotAuthorizedError`
  #   ->(tenant) { ... }   a callable run in the controller's context for full
  #                        control: redirect_to(...), head(:forbidden), or raise
  #                        your own. The resolved tenant is the sole argument.
  # config.on_not_a_member = :not_a_member_error

  # How resolution finds the acting user (auth-agnostic). The default reads the
  # host app's `Current.user`; point it at your auth layer if different, e.g.
  # `-> { current_user }` for Devise.
  # config.current_user_resolver = -> { (defined?(::Current) && ::Current.respond_to?(:user)) ? ::Current.user : nil }
end
