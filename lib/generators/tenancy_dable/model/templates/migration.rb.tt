# frozen_string_literal: true

# Tenant-scoped table: `<%= tenant_reference_name %>_id` is added first (with its index and FK)
# so the row always carries its owning tenant; TenancyDable scopes every query by
# it. The remaining columns come from the generator's field:type arguments.
class <%= migration_class_name %> < ActiveRecord::Migration[<%= ActiveRecord::Migration.current_version %>]
  def change
    create_table :<%= table_name %> do |t|
      t.references :<%= tenant_reference_name %>, null: false, foreign_key: true
<% attributes.reject(&:virtual?).reject { |attribute| attribute.name == tenant_reference_name }.each do |attribute| -%>
      t.<%= attribute.type %> :<%= attribute.name %><%= attribute.inject_options %>
<% end -%>
<% if options[:timestamps] -%>

      t.timestamps
<% end -%>
    end
<% attributes_with_index.each do |attribute| -%>
    add_index :<%= table_name %>, :<%= attribute.index_name %><%= attribute.inject_index_options %>
<% end -%>
  end
end
